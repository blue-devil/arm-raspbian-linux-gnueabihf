# Maintainer: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=arm-raspbian-linux-gnueabihf
pkgname=${_target}-openssl-1.1
_pkgname=openssl
_ver=1.1.1w
# use a pacman compatible version scheme
pkgver=${_ver/[a-z]/.${_ver//[0-9.]/}}
pkgrel=1
pkgdesc="The Open Source toolkit for Secure Sockets Layer and Transport Layer Security, 1.1 branch (Raspbian Jessie ARMv6 target, ${_target})"
arch=(any)
url='https://www.openssl.org'
license=(custom:BSD)
depends=("${_target}-glibc" "${_target}-zlib")
makedepends=("${_target}-gcc" perl)
options=(!buildflags !strip !lto !debug !emptydirs staticlibs)
source=("https://www.openssl.org/source/old/1.1.1/${_pkgname}-${_ver}.tar.gz"{,.asc}
        ca-dir.patch)
sha256sums=('cf3098950cb4d853ad95c0841f1f9c6d3dc102dccfcacd521d93925208b76ac8'
            'SKIP'
            '75aa8c2c638c8a3ebfd9fa146fc61c7ff878fc997dc6aa10d39e4b2415d669b2')
validpgpkeys=('8657ABB260F056B1E5190839D9C4D26D0E604491'  # Matt Caswell <matt@openssl.org>
              '7953AC1FBC3DC8B3B292393ED5E9E43F7DF9EE8C'  # Richard Levitte <richard@openssl.org>
              'A21FAB74B0088AA361152586B8EF1A6BA9DA2D5C'  # Tomáš Mráz <tomas@openssl.org>
              'EFC0A467D613CB83C7ED6D30D894E2CE8B3D79F5') # OpenSSL OMC <openssl-omc@openssl.org>

prepare() {
  cd ${_pkgname}-${_ver}

  # set ca dir to /etc/ssl by default
  patch -p0 -i "${srcdir}"/ca-dir.patch
}

build() {
  cd ${_pkgname}-${_ver}

  # never let the host's aarch64 flags reach the cross compiler
  unset CC CXX CFLAGS CPPFLAGS CXXFLAGS LDFLAGS

  ./Configure \
    --prefix=/usr/${_target} \
    --libdir=lib/openssl-1.1 \
    --cross-compile-prefix=${_target}- \
    -DOPENSSL_NO_CAPIENG \
    no-ssl3-method \
    threads \
    shared \
    zlib-dynamic \
    linux-armv4 \
    "-Wa,--noexecstack"

  make
}

package() {
  cd ${_pkgname}-${_ver}

  make DESTDIR="${pkgdir}" install_sw

  # Move some files around so 1.0 and 1.1 can coexist in the sysroot
  install -m755 -d "${pkgdir}"/usr/${_target}/include/openssl-1.1
  mv "${pkgdir}"/usr/${_target}/include/openssl "${pkgdir}"/usr/${_target}/include/openssl-1.1/
  mv "${pkgdir}"/usr/${_target}/lib/openssl-1.1/libcrypto.so.1.1 "${pkgdir}"/usr/${_target}/lib/
  mv "${pkgdir}"/usr/${_target}/lib/openssl-1.1/libssl.so.1.1 "${pkgdir}"/usr/${_target}/lib/
  ln -sf ../libssl.so.1.1 "${pkgdir}"/usr/${_target}/lib/openssl-1.1/libssl.so
  ln -sf ../libcrypto.so.1.1 "${pkgdir}"/usr/${_target}/lib/openssl-1.1/libcrypto.so
  mv "${pkgdir}"/usr/${_target}/bin/openssl "${pkgdir}"/usr/${_target}/bin/openssl-1.1

  # Update includedir in .pc files
  sed -e 's|/include$|/include/openssl-1.1|' -i "${pkgdir}"/usr/${_target}/lib/openssl-1.1/pkgconfig/*.pc

  rm -rf "${pkgdir}"/usr/${_target}/bin/c_rehash "${pkgdir}"/etc

  install -Dm644 LICENSE "${pkgdir}"/usr/${_target}/share/licenses/${pkgname}/LICENSE

  # every ELF file: drop DWARF only, keep symbol tables (objdump -f probes the format)
  find "${pkgdir}"/usr/${_target}/lib -type f \
    -exec sh -c '"$1" -f "$3" >/dev/null 2>&1 && "$2" --strip-debug "$3"' _ ${_target}-objdump ${_target}-strip {} \;
}

