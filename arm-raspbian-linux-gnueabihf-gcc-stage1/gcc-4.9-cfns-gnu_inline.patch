GCC 4.9 cannot be built by GCC >= 6 hosts: the gperf-generated cfns.h declares
libc_name_p as plain __inline but defines it __gnu_inline__, which newer C++ front
ends reject ("redeclared inline with gnu_inline attribute").  Give the prototype
the same attribute (this is what newer gperf emits; upstream fixed it in r233572).

--- a/gcc/cp/cfns.h
+++ b/gcc/cp/cfns.h
@@ -53,6 +53,9 @@
 static unsigned int hash (const char *, unsigned int);
 #ifdef __GNUC__
 __inline
+#ifdef __GNUC_STDC_INLINE__
+__attribute__ ((__gnu_inline__))
+#endif
 #endif
 const char * libc_name_p (const char *, unsigned int);
 /* maximum key range = 391, duplicates = 0 */
