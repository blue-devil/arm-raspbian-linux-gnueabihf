# Maintainer: Wilken Gottwalt <wilken dot gottwalt at posteo dot net>
# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=arm-raspbian-linux-gnueabihf
pkgname=${_target}-gcc
pkgver=4.9.2
pkgrel=1
pkgdesc="The GNU Compiler Collection - cross compiler for the Raspbian Jessie ARMv6 target (${_target})"
arch=(aarch64 x86_64)
url='https://gcc.gnu.org'
license=(GPL-3.0-or-later LGPL-3.0-or-later GFDL-1.3-or-later custom)
depends=("${_target}-binutils>=2.25" "${_target}-glibc>=2.19" libmpc zlib)
makedepends=(gmp mpfr libmpc)
options=(!emptydirs !distcc !strip !buildflags !lto !debug staticlibs)
conflicts=("${_target}-gcc-stage1")
replaces=("${_target}-gcc-stage1")
provides=("${_target}-gcc-stage1=${pkgver}")
source=(https://ftp.gnu.org/gnu/gcc/gcc-${pkgver}/gcc-${pkgver}.tar.bz2{,.sig}
        gcc-4.9-cfns-gnu_inline.patch)
sha256sums=('2020c98295856aa13fda0f2f3a4794490757fc24bcca918d52cc8b4917b972dd'
            'SKIP'
            'de36837b295aa7a9f3d956f6d79e5540dc1f4e35cbc4ea64fee6ece7f519aae5')
validpgpkeys=('33C235A34C46AA3FFB293709A328C3A2C3C45C06') # Jakub Jelinek <jakub@redhat.com>

prepare() {
  cd gcc-${pkgver}

  # GCC >= 6 hosts reject cfns.h ("redeclared inline with gnu_inline attribute")
  patch -p1 -i "${srcdir}"/gcc-4.9-cfns-gnu_inline.patch

  # Do not run fixincludes
  sed -i 's@\./fixinc\.sh@-c true@' gcc/Makefile.in

  # some configure tests for header files use "$CPP $CPPFLAGS"
  sed -i "/ac_cpp=/s/\$CPPFLAGS/\$CPPFLAGS -O2/" {libiberty,gcc}/configure

  mkdir -p "${srcdir}"/gcc-build
}

build() {
  cd gcc-build

  # 2014-era host sources compiled by a 2026 GCC: pin the language standards they were
  # written for and turn the new C errors (implicit declarations, pointer conversions)
  # back into warnings. Target code (libgcc, libstdc++, ...) is built by the freshly
  # built cross compiler with CFLAGS_FOR_TARGET, exactly as Debian did (-g -O2).
  export CFLAGS='-O2 -pipe -std=gnu11 -fpermissive'
  export CXXFLAGS='-O2 -pipe -std=gnu++98 -fpermissive'
  export LDFLAGS=''
  export CFLAGS_FOR_TARGET='-O2 -g'
  export CXXFLAGS_FOR_TARGET='-O2 -g'

  # Mirrors Raspbian's gcc-4.9 4.9.2-10 configuration (see README.md); the languages
  # nobody cross-compiles for a Pi (java, go, d, fortran, objc) and graphite (isl/cloog)
  # are left out.
  # --with-build-sysroot is required: the sysroot lies under ${prefix}, so GCC makes it
  # relocatable relative to the driver, and the not-yet-installed xgcc would hand ld a
  # sysroot inside the build tree (ld 2.25 then resolves the libc.so linker script's
  # absolute /lib/libc.so.6 on the host).
  ../gcc-${pkgver}/configure \
    --target=${_target} \
    --host=${CHOST} \
    --build=${CHOST} \
    --prefix=/usr \
    --libdir=/usr/lib \
    --libexecdir=/usr/lib \
    --with-sysroot=/usr/${_target} \
    --with-build-sysroot=/usr/${_target} \
    --with-native-system-header-dir=/include \
    --with-as=/usr/bin/${_target}-as \
    --with-ld=/usr/bin/${_target}-ld \
    --with-arch=armv6 \
    --with-fpu=vfp \
    --with-float=hard \
    --with-linker-hash-style=both \
    --with-pkgversion="${_target} ${pkgver}-${pkgrel}" \
    --with-system-zlib \
    --without-isl \
    --without-cloog \
    --enable-languages=c,c++,lto \
    --enable-__cxa_atexit \
    --enable-checking=release \
    --enable-clocale=gnu \
    --enable-gnu-unique-object \
    --enable-libstdcxx-time=yes \
    --enable-linker-build-id \
    --enable-lto \
    --enable-multiarch \
    --enable-plugin \
    --enable-shared \
    --enable-threads=posix \
    --disable-libitm \
    --disable-libquadmath \
    --disable-libssp \
    --disable-libstdcxx-pch \
    --disable-multilib \
    --disable-nls \
    --disable-sjlj-exceptions \
    --disable-werror

  # GCC 4.9's top-level Makefile re-assigns CXXFLAGS_FOR_TARGET = $(CXXFLAGS) for
  # non-bootstrap builds, which would push -std=gnu++98 into libstdc++ (its c++11/
  # sources need gnu++11): force the target flags on the make command line
  make CFLAGS_FOR_TARGET="${CFLAGS_FOR_TARGET}" CXXFLAGS_FOR_TARGET="${CXXFLAGS_FOR_TARGET}"
}

package() {
  cd gcc-build

  make DESTDIR="${pkgdir}" CFLAGS_FOR_TARGET='-O2 -g' CXXFLAGS_FOR_TARGET='-O2 -g' install

  # owned by the host gcc package; usr/share/gcc-4.9.2 (libstdc++ gdb pretty printers) stays
  rm -rf "${pkgdir}"/usr/share/{info,man/man7,locale}
  # fixincludes machinery is useless once installed
  rm -rf "${pkgdir}"/usr/lib/gcc/${_target}/${pkgver}/install-tools

  # strip by hand: makepkg's strip must not touch the ARM objects. Host executables
  # lose everything unneeded; every target ELF file (libstdc++, libgcc_s, crt*.o, .a)
  # only its DWARF (it embeds ${srcdir}), keeping the symbol tables for the cross gdb.
  # objdump -f probes the format (linker scripts, .py files are skipped).
  find "${pkgdir}"/usr/bin "${pkgdir}"/usr/lib/gcc/${_target}/${pkgver} -type f -executable \
    -exec strip --strip-unneeded {} + 2>/dev/null || true
  find "${pkgdir}"/usr/lib/gcc/${_target}/${pkgver} "${pkgdir}"/usr/${_target}/lib -type f \
    -exec sh -c '"$1" -f "$3" >/dev/null 2>&1 && "$2" --strip-debug "$3"' _ ${_target}-objdump ${_target}-strip {} \;
}

# vim: ts=2 sw=2 et:
