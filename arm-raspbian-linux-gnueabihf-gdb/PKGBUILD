# Contributor: Blue DeviL // SCT <bluedevil [dot] SCT [at] proton [dot] me>

_target=arm-raspbian-linux-gnueabihf
pkgname=${_target}-gdb
pkgver=17.2
pkgrel=1
pkgdesc="The GNU Debugger for the Raspbian Jessie ARMv6 target (${_target})"
arch=(aarch64 x86_64)
url='https://www.gnu.org/software/gdb/'
license=(GPL-3.0-or-later)
depends=(expat gdb-common gmp libelf mpfr ncurses python readline source-highlight xz zstd)
makedepends=(boost)
options=(!emptydirs)
source=(https://ftp.gnu.org/gnu/gdb/gdb-${pkgver}.tar.xz{,.sig})
sha256sums=('1c036c0d72e4b3d1fb5c94c88632add6f9d76f4d7c4d2ea793c12a9f19a3228c'
            'SKIP')
validpgpkeys=('F40ADB902B24264AA42E50BF92EDB04BFF325CF3') # Joel Brobecker <brobecker@adacore.com>

prepare() {
  mkdir -p "${srcdir}"/gdb-build
}

build() {
  cd gdb-build

  # --with-sysroot: 'set sysroot' defaults to our glibc, so the debugger finds
  # ld-linux-armhf.so.3, libc & friends (with symbols) when attached to qemu-arm -g
  ../gdb-${pkgver}/configure \
    --target=${_target} \
    --prefix=/usr \
    --with-sysroot=/usr/${_target} \
    --with-system-readline \
    --with-python=/usr/bin/python \
    --with-system-gdbinit=/etc/gdb/gdbinit \
    --enable-languages=c,c++ \
    --enable-tui \
    --enable-source-highlight \
    --without-guile \
    --without-debuginfod \
    --disable-nls \
    --disable-multilib \
    --disable-sim \
    --disable-werror

  make
}

package() {
  cd gdb-build

  make -C gdb DESTDIR="${pkgdir}" install

  # owned by the host gdb / gdb-common packages
  rm -r "${pkgdir}"/usr/share/{gdb,info,man/man5}
  rm -r "${pkgdir}"/usr/include/gdb
}

